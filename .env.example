# Safe default: simulated lights, no credentials, loopback only.
GOVEE_MODE=demo
MCP_TRANSPORT=http
HOST=127.0.0.1
PORT=3000

# Live mode: configure privately. Never commit or paste your key into chat.
# GOVEE_API_KEY=
# GOVEE_ALLOWED_DEVICES=device-id-1,device-id-2

# Required for live HTTP. Obtain/configure OAuth separately, with consent.
# OAUTH_ISSUER=https://your-issuer.example
# OAUTH_JWKS_URL=https://your-issuer.example/.well-known/jwks.json
# MCP_RESOURCE_URL=https://your-mcp.example/mcp
# OAUTH_ALLOWED_SUBJECTS=your-exact-oauth-subject
